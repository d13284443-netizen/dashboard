# SECRETS — never commit. .env holds the Supabase service_role key,
# which bypasses all Row-Level Security. Treat a leak of this file as a
# full database compromise: rotate the key in Supabase immediately
# (Project Settings > API > service_role > Reveal/Rotate).
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local runtime artefacts — data and logs, not source
logs/
*.log
processed/
failed/
*.xlsx
