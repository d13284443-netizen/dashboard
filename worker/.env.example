# Supabase — Project Settings > API.
# SERVICE key, not anon: these workers run on your VPS and must bypass RLS.
# This key must never reach a browser or a public repo.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Telegram — create a bot with @BotFather, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging it once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Where the Chrome extension saves downloads on this VPS.
WATCH_DIR=C:\Users\Administrator\Downloads
WATCH_PATTERN=options-*.xlsx
INSTRUMENT=GOLD

# Timezone the CQG filenames are stamped in = the VPS's local timezone,
# since CQG names files in browser local time. If the VPS clock is UTC,
# leave this as UTC. If the VPS runs local time (e.g. Dubai), set the
# IANA zone so filename times convert correctly. Getting this wrong
# skews every snapshot timestamp by the offset.
# Check the VPS clock with:  python -c "import time; print(time.tzname)"
WATCH_TZ=UTC

# --- Detector tuning (defaults are sized for a 15-20 min cadence) ---
EMA_HALFLIFE_MINUTES=90
MIN_SAMPLES=4
MIN_BASELINE_SPAN_MINUTES=60
SPIKE_THRESHOLD_PCT=0.10
DRIFT_WINDOWS_HOURS=1,3,6,24

# --- Liquidity gate ---
MIN_OI=10
MAX_SPREAD_PCT=0.50
MIN_ABS_DELTA=5
MAX_ABS_DELTA=95

# --- Alerting ---
# true  = week-1 shadow mode: alert on the raw rule, record the
#         smile-adjusted numbers alongside for comparison.
# false = alert only when the smile-adjusted change also clears threshold.
ALERT_ON_RAW=true
MAX_ALERTS_PER_CYCLE=6
